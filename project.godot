; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CapMonster"
config/description="Monster Idle RPG - colecione, treine e evolua criaturas de Ã©ter."
config/version="0.9.0"
run/main_scene="res://scenes/main/Boot.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/ui/icone.png"

; A abertura padrão da Godot é o logo azul da engine sobre cinza. Trocando pela
; nossa e igualando o fundo ao da cena Boot, não existe salto: a logo aparece,
; a cena entra por cima com a mesma logo no mesmo fundo, e o jogador não vê
; "carregando engine" antes de ver o jogo.
boot_splash/bg_color=Color(0.043, 0.055, 0.067, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

GameLog="*res://scripts/core/GameLog.gd"
InputActions="*res://scripts/core/InputSetup.gd"
DataManager="*res://scripts/managers/DataManager.gd"
SaveManager="*res://scripts/managers/SaveManager.gd"
Renderizador="*res://scripts/core/Renderizador.gd"
Atualizador="*res://scripts/core/Atualizador.gd"
GameManager="*res://scripts/managers/GameManager.gd"
AudioManager="*res://scripts/managers/AudioManager.gd"
QuestManager="*res://scripts/managers/QuestManager.gd"
IdleManager="*res://scripts/managers/IdleManager.gd"
SceneFlow="*res://scripts/managers/SceneFlow.gd"
Notify="*res://scripts/managers/Notify.gd"
Rede="*res://scripts/net/Rede.gd"
MundoRede="*res://scripts/net/MundoRede.gd"
Chat="*res://scripts/net/Chat.gd"
Ficha="*res://scripts/net/Ficha.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2

; Mesma cor da abertura. Sem isto, o quadro entre a abertura sumir e a primeira
; cena desenhar sai no cinza padrão da engine — um piscada clara no meio do
; escuro, que é justamente o que denuncia "isto foi feito na Godot".
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.067, 1)
